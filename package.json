{
  "name": "api-maasterplan",
  "version": "0.1.0",
  "private": true,
  "description": "API GTFS haut niveau — RFU Sytral Mobilités",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch --clear-screen=false --exclude 'data/**' --exclude 'client/**' --exclude 'dist/**' --exclude '**/*.{html,css,svg,png,db,db-*}' src/index.ts",
    "dev:client": "npm run client:dev",
    "build": "tsc -p tsconfig.build.json",
    "build:deploy": "prisma generate && npm run build && cd client && npm ci && npm run build",
    "start": "node dist/index.js",
    "start:prod": "prisma migrate deploy && node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "client:dev": "cd client && npm run dev",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@prisma/client": "^5.22.0",
    "adm-zip": "^0.5.16",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^4.28.1",
    "node-cron": "^3.0.3",
    "prisma": "^5.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.10.1",
    "@types/node-cron": "^3.0.11",
    "concurrently": "^10.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
