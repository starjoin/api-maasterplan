# Copier vers .env.local et renseigner
DATABASE_URL=file:./data/maasterplan.db
RFU_API_TOKEN=
RFU_API_TOKEN_NETEX=

# SIRI-Lite Vehicle Monitoring (Grand Lyon) — Basic Auth
# Compte perso recommandé : https://data.grandlyon.com/onegeo-login/fr/profile/
# Défaut = compte démo Data Grand Lyon (ok pour le développement)
SIRI_VM_URL=https://data.grandlyon.com/siri-lite/2.0/vehicle-monitoring.json
SIRI_VM_USER=demo
SIRI_VM_PASSWORD=demo4dev
SIRI_VM_POLL_MS=10000
SIRI_VM_ENABLED=true
RFU_NETEX_URL=https://chouette.enroute.mobi/api/v1/datas/SYTRALMOBILITES_RFU_RHONE/netex.zip
RFU_NETEX_INFO_URL=https://chouette.enroute.mobi/api/v1/datas/SYTRALMOBILITES_RFU_RHONE

# Cible 4 Go RAM (HTTP + un seul import à la fois)
DATABASE_URL_GTFS=file:./data/maasterplan.db
DATABASE_URL_NETEX=file:./data/netex.db
IMPORT_HEAP_MB=768
IMPORT_RSS_MB=1400
IMPORT_BATCH_SIZE=500
IMPORT_MAX_MINUTES=360
# Taille maximale des fichiers téléchargés / extraits : 20 Go
IMPORT_MAX_BYTES=21474836480
AUTO_IMPORT_ON_START=false
# Stockage disque persistant, pas de tmpfs RAM
TMP_DIR=/app/data/tmp
